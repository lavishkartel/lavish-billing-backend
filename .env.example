# Square configuration
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=YOUR_SQUARE_ACCESS_TOKEN
SQUARE_LOCATION_ID=YOUR_LOCATION_ID
SQUARE_APP_ID=YOUR_APP_ID
SQUARE_REDIRECT_URL=https://lavish-legacy.example/checkout/complete
SQUARE_WEBHOOK_SIGNATURE_KEY=YOUR_SQUARE_WEBHOOK_SIGNING_SECRET
WEBHOOK_URL=https://your-webhook-host.example/events

# Crypto payment listener configuration
CRYPTO_RPC_URL=https://arb1.your-rpc-provider.example
CRYPTO_PAYMENT_ADDRESS=0xYourReceivingAddress
CRYPTO_PAYMENT_AMOUNT=0.01
CRYPTO_PAYMENT_TOKEN=ETH
CRYPTO_POLL_INTERVAL_MS=15000

# Server config
PORT=4000
